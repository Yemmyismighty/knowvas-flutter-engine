# Android Keystore Configuration Template
# Copy this file to key.properties and fill in your actual values
# NEVER commit key.properties to version control!

# Path to your keystore file (absolute or relative to android/ directory)
storeFile=/path/to/your/knowvas-release.keystore

# Keystore password
storePassword=your_store_password_here

# Key alias
keyAlias=knowvas

# Key password
keyPassword=your_key_password_here
