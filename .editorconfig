# EditorConfig helps maintain consistent coding styles across different editors and IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,kt,swift}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.gradle]
indent_style = space
indent_size = 4

[*.{json,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
